# Copy this file to .env and fill in real values for local development.

NODE_ENV=development
PORT=4000

# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_resume_builder

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-hex-string
JWT_REFRESH_SECRET=change-me-to-a-different-random-64-char-hex-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGIN=http://localhost:3000

# Default AI provider when a user hasn't set a personal preference.
# One of: mock | openai | anthropic | gemini | deepseek
AI_PROVIDER=mock

# Optional global fallback keys. Users can also bring their own key via
# Settings -> AI Provider, which takes priority over these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Used to encrypt user-supplied AI provider API keys at rest.
# Generate with: openssl rand -hex 32
AI_SETTINGS_ENCRYPTION_KEY=change-me-to-a-random-32-char-minimum-secret

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
