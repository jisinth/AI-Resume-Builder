generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  LOCAL
  GOOGLE
  GITHUB
}

enum SubscriptionPlan {
  FREE
  PRO
  TEAM
}

enum ResumeTemplateSlug {
  modern
  minimal
  corporate
  ats_friendly
}

enum ApplicationStatus {
  WISHLIST
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String?
  name          String
  avatarUrl     String?
  authProvider  AuthProvider @default(LOCAL)
  providerId    String?
  refreshToken  String?
  aiSettings    UserAiSettings?
  resumes       Resume[]
  coverLetters  CoverLetter[]
  linkedInProfile LinkedInProfile?
  applications  Application[]
  subscription  Subscription?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("users")
}

/// Per-user, encrypted-at-rest API keys for "bring your own key" AI providers.
model UserAiSettings {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredProvider String   @default("mock")
  openaiKeyCipher   String?
  anthropicKeyCipher String?
  geminiKeyCipher   String?
  deepseekKeyCipher String?
  updatedAt         DateTime @updatedAt

  @@map("user_ai_settings")
}

model Resume {
  id            String             @id @default(uuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  templateSlug  ResumeTemplateSlug @default(modern)
  isPrimary     Boolean            @default(false)
  atsScore      Int?
  personalInfo  PersonalInfo?
  experience    Experience[]
  education     Education[]
  projects      Project[]
  skills        Skill[]
  achievements  Achievement[]
  certificates  Certificate[]
  versions      ResumeVersion[]
  applications  Application[]
  coverLetters  CoverLetter[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userId])
  @@map("resumes")
}

model PersonalInfo {
  id        String  @id @default(uuid())
  resumeId  String  @unique
  resume    Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  fullName  String
  headline  String?
  email     String
  phone     String?
  location  String?
  website   String?
  linkedin  String?
  github    String?
  summary   String?

  @@map("personal_info")
}

model Experience {
  id         String   @id @default(uuid())
  resumeId   String
  resume     Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  company    String
  title      String
  location   String?
  startDate  DateTime
  endDate    DateTime?
  isCurrent  Boolean  @default(false)
  bullets    String[]
  order      Int      @default(0)

  @@index([resumeId])
  @@map("experience")
}

model Education {
  id            String    @id @default(uuid())
  resumeId      String
  resume        Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  institution   String
  degree        String
  fieldOfStudy  String?
  startDate     DateTime
  endDate       DateTime?
  gpa           String?
  order         Int       @default(0)

  @@index([resumeId])
  @@map("education")
}

model Project {
  id            String   @id @default(uuid())
  resumeId      String
  resume        Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  name          String
  description   String   @default("")
  technologies  String[]
  url           String?
  bullets       String[]
  order         Int      @default(0)

  @@index([resumeId])
  @@map("projects")
}

model Skill {
  id        String            @id @default(uuid())
  resumeId  String
  resume    Resume            @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  name      String
  category  String?
  level     ProficiencyLevel?
  order     Int               @default(0)

  @@index([resumeId])
  @@map("skills")
}

model Achievement {
  id           String    @id @default(uuid())
  resumeId     String
  resume       Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  date         DateTime?
  order        Int       @default(0)

  @@index([resumeId])
  @@map("achievements")
}

model Certificate {
  id             String    @id @default(uuid())
  resumeId       String
  resume         Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  name           String
  issuer         String
  issueDate      DateTime?
  expiryDate     DateTime?
  credentialUrl  String?
  order          Int       @default(0)

  @@index([resumeId])
  @@map("certificates")
}

/// Immutable snapshot of a resume at a point in time. Restore/compare
/// endpoints are tracked in ROADMAP.md and not yet implemented.
model ResumeVersion {
  id         String   @id @default(uuid())
  resumeId   String
  resume     Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  label      String
  snapshot   Json
  createdAt  DateTime @default(now())

  @@index([resumeId])
  @@map("resume_versions")
}

/// Cover letter generation UI/API is tracked in ROADMAP.md; model exists so
/// the schema represents the full target domain.
model CoverLetter {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId     String?
  resume       Resume?  @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  jobTitle     String
  companyName  String
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("cover_letters")
}

/// LinkedIn Optimizer UI/API is tracked in ROADMAP.md; model exists so the
/// schema represents the full target domain.
model LinkedInProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline     String
  about        String
  experience   String
  skills       String[]
  featured     String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("linkedin_profiles")
}

/// Job tracker UI/API is tracked in ROADMAP.md; model exists so the schema
/// represents the full target domain.
model Application {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId   String?
  resume     Resume?           @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  company    String
  role       String
  jobUrl     String?
  status     ApplicationStatus @default(WISHLIST)
  appliedAt  DateTime?
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([userId])
  @@map("applications")
}

model Template {
  id           String             @id @default(uuid())
  slug         ResumeTemplateSlug @unique
  name         String
  description  String
  isPremium    Boolean            @default(false)
  previewUrl   String?

  @@map("templates")
}

/// Billing integration is tracked in ROADMAP.md; model exists so the schema
/// represents the full target domain.
model Subscription {
  id                String           @id @default(uuid())
  userId            String           @unique
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              SubscriptionPlan @default(FREE)
  currentPeriodEnd  DateTime?
  createdAt         DateTime         @default(now())

  @@map("subscriptions")
}
