# Copy to docker/.env and customize before running `docker compose up` for
# anything beyond local experimentation. docker-compose.yml falls back to
# insecure development defaults if these are not set.

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
AI_SETTINGS_ENCRYPTION_KEY=

AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
